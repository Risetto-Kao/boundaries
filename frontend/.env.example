# Supabase 設定
# 前往 https://supabase.com 建立專案後，從 Settings > API 取得
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 現有程式未使用 service role key；build / Cloud setup 不需設定。
# 若未來需要，僅放在 server 的安全環境設定，絕不可加 NEXT_PUBLIC_。
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 資料庫連線（從 Supabase Settings > Database 取得）
# Local / Cloud / Preview 請使用隔離的開發資料庫，不要填正式資料庫憑證。
# Connection Pooling URL（用於 Serverless）
DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Direct Connection URL（用於 Migration）
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# OAuth callback origin for this environment, with no trailing path.
# Must match a Supabase Auth Redirect URL. Preview must use its own URL.
AUTH_SITE_URL=http://localhost:3000
# Google Client ID/Secret belong in Supabase Auth > Providers > Google,
# not in browser variables or this repository.

# Enable ONLY after account-history.sql and at least one OAuth provider are configured.
# Defaults to guest-only compatibility with the existing database schema.
ACCOUNT_HISTORY_ENABLED=false

# Providers are independently enabled after their Supabase configuration is ready.
# Google remains on by default for backwards compatibility; LINE is opt-in.
AUTH_GOOGLE_ENABLED=true
AUTH_LINE_ENABLED=false
# LINE Login channel secret is stored only in Supabase Auth custom:line,
# never in the app/browser environment or git.
