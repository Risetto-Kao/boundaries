# Supabase 設定
# 前往 https://supabase.com 建立專案後，從 Settings > API 取得
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key（保密！僅後端使用）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 資料庫連線（從 Supabase Settings > Database 取得）
# Connection Pooling URL（用於 Serverless）
DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Direct Connection URL（用於 Migration）
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
